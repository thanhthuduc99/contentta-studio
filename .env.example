# ===== Contentta Studio — cấu hình =====
# Copy file này thành .env rồi điền giá trị của bạn:  cp .env.example .env
# KHÔNG commit file .env (đã bị .gitignore).

# --- Phụ đề (transcribe giọng -> chữ) ---
# BẮT BUỘC nếu dùng phụ đề mặc định (OpenAI Whisper, ~$0.006/phút audio).
# Lấy key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Tạo b-roll bằng AI (ảnh/video) — TÙY CHỌN ---
# Lấy key: https://fal.ai/dashboard/keys
FAL_KEY=

# --- Tự tải b-roll stock miễn phí — TÙY CHỌN ---
# Lấy key free: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Đăng nhập (bảo vệ app khi deploy public) — TÙY CHỌN ---
# Để TRỐNG cả 2 dòng = app KHÔNG cần đăng nhập (chạy local thoải mái).
AUTH_USER=
AUTH_PASSWORD=
# Chuỗi ngẫu nhiên bất kỳ để ký cookie phiên (đổi thành của bạn).
AUTH_SECRET=doi-thanh-chuoi-ngau-nhien-cua-ban

# --- Cổng chạy server — TÙY CHỌN (mặc định 3100) ---
PORT=3100
